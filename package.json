{
  "name": "@dwtechs/toker",
  "version": "0.2.2",
  "description": "Open source JWT management library for Node.js to sign, verify and parse bearer safely.",
  "keywords": [
    "jwt",
    "token",
    "bearer",
    "authentication"
  ],
  "homepage": "https://github.com/DWTechs/Toker.js",
  "type": "module",
  "main": "dist/toker.js",
  "types": "dist/toker.d.ts",
  "exports": {
    ".": {
      "import": "./dist/toker.js",
      "types": "./dist/toker.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DWTechs/Toker.js"
  },
  "bugs": {
    "url": "https://github.com/DWTechs/Toker.js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber",
    "url": "http://www.lcluber.com"
  },
  "scripts": {
    "prebuild": "npm install",
    "build": "node ./scripts/clear && tsc && npm run rollup && node ./scripts/copy && npm run test",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "jest --coverage"
  },
  "files": [
    "dist/"
  ],
    "engines": {
      "node": ">= 22"
  },
  "dependencies": {
    "@dwtechs/checkard": "3.6.1",
    "@dwtechs/hashitaka": "0.4.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.0",
    "@types/node": "25.6.0",
    "jest": "29.7.0",
    "rollup": "4.24.0",
    "typescript": "6.0.3"
  }
}
